#!/usr/bin/env python3
"""
Redragon Volume CLI client
Fast Unix-socket client for redragon-control-daemon.
"""

import os
import socket
import sys

SOCKET_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "redragon-control.sock")


def send_command(cmd: str, timeout: float = 5.0) -> str:
    """Send a command to the control daemon and return its response."""
    if not os.path.exists(SOCKET_PATH):
        raise RuntimeError(
            f"Daemon socket not found: {SOCKET_PATH}\n"
            "Is redragon-control-daemon running? Try:\n"
            "  systemctl --user start redragon-control-daemon"
        )

    if not os.path.exists(SOCKET_PATH) or not os.access(SOCKET_PATH, os.R_OK | os.W_OK):
        raise RuntimeError(
            f"Cannot access daemon socket: {SOCKET_PATH}\n"
            "Check permissions or if the daemon is running under a different user session."
        )

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(SOCKET_PATH)
        sock.sendall(cmd.encode("utf-8"))
        try:
            sock.shutdown(socket.SHUT_WR)
        except OSError:
            pass

        chunks = []
        while True:
            try:
                data = sock.recv(4096)
            except socket.timeout:
                break
            if not data:
                break
            chunks.append(data)

        response = b"".join(chunks).decode("utf-8", "replace").strip()
        if not response:
            raise RuntimeError("Daemon returned an empty response")
        return response
    finally:
        sock.close()


def get_volume() -> int:
    """Ask the daemon for the current effective volume."""
    resp = send_command("get")
    if resp.startswith("OK:"):
        return int(resp.split(":", 1)[1].strip())
    raise RuntimeError(resp)


def usage() -> None:
    print("Usage: redragon-volume <command>")
    print()
    print("Commands:")
    print("  status       Show headset status")
    print("  get          Get current volume percentage")
    print("  mute         Toggle mute")
    print("  <number>     Set volume to 0-100")
    print("  +<number>    Increase volume")
    print("  -<number>    Decrease volume")
    print("  ping         Test daemon connectivity")
    print()
    print("Examples:")
    print("  redragon-volume 75")
    print("  redragon-volume +10")
    print("  redragon-volume -5")
    sys.exit(0)


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        usage()

    arg = sys.argv[1].strip()

    try:
        if arg == "status":
            print(send_command("status"))

        elif arg == "ping":
            resp = send_command("ping")
            if resp == "OK: pong":
                print("Daemon is reachable")
            else:
                print(f"Unexpected response: {resp}", file=sys.stderr)
                return 1

        elif arg == "get":
            print(f"Volume: {get_volume()}%")

        elif arg == "mute":
            resp = send_command("mute")
            if resp.startswith("OK:"):
                print(resp.split(":", 1)[1].strip())
            else:
                print(resp, file=sys.stderr)
                return 1

        elif arg.startswith(("+", "-")):
            delta = int(arg)
            current = get_volume()
            new_vol = max(0, min(100, current + delta))
            resp = send_command(f"set {new_vol}")
            if resp.startswith("OK:"):
                print(f"Volume: {new_vol}%")
            else:
                print(resp, file=sys.stderr)
                return 1

        elif arg.isdigit():
            volume = int(arg)
            if volume < 0 or volume > 100:
                print("Volume must be between 0 and 100", file=sys.stderr)
                return 1
            resp = send_command(f"set {volume}")
            if resp.startswith("OK:"):
                print(f"Volume: {volume}%")
            else:
                print(resp, file=sys.stderr)
                return 1

        else:
            print(f"Invalid command: {arg}", file=sys.stderr)
            usage()

    except (RuntimeError, ValueError, ConnectionRefusedError, PermissionError) as exc:
        print(f"Error communicating with daemon: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:  # noqa: BLE001
        print(f"Error communicating with daemon: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
